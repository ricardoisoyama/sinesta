# Copie para .env (na mesma pasta do docker-compose.prod.yml) e ajuste.
# NÃO comitar o .env com valores reais.

# Senha do Postgres (use algo forte e único).
POSTGRES_PASSWORD=troque-esta-senha

# Chave de assinatura do JWT (>= 32 caracteres aleatórios; a chave de exemplo do
# repositório é recusada em produção).
# Gere uma: openssl rand -base64 48
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-longa-de-producao

# Porta HTTP do front (nginx) no host. Fica presa em 127.0.0.1: quem publica na internet
# é o Apache do cPanel (.htaccess do domínio faz proxy para 127.0.0.1:HTTP_PORT) com TLS.
HTTP_PORT=8080

# Seed no banco VAZIO (só na primeira subida):
#   false (padrão) = só o admin (sistema do zero para o cliente)
#   true           = também empresas/custos/taxas/plano/metas/modelos + usuários demo
#                    com senha conhecida (NUNCA em produção)
SEED_DEMO=false

# Senha inicial do admin (admin@elrond.com.br) na primeira subida. Em branco = o backend
# gera uma senha aleatória e mostra uma única vez em `docker logs elrond-backend-1`.
ADMIN_SENHA_INICIAL=
